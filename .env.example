# Copy to .env.local. Never commit real values. With nothing set, the app runs in demo mode.

# Which providers to use. Unknown or unconfigured choices fall back to mock (see /api/health).
ROUTE_PROVIDER=mock          # google | osrm | mock
TRAFFIC_PROVIDER=mock        # google | tomtom | historical | mock

# Phase 4 (not implemented yet; setting these alone does nothing until the clients ship).
GOOGLE_MAPS_API_KEY=         # Routes API + Places. Restrict by HTTP referrer/IP and set quotas.
TOMTOM_API_KEY=              # Second traffic source for comparison.
OSRM_URL=                    # Self-hosted OSRM base URL, e.g. https://osrm.example.com

# Postgres for zones, route logs, and a shared cache (Phase 4). SQLite is fine locally.
DATABASE_URL=

# Map style. Defaults to OpenFreeMap Positron (free, no key, OpenStreetMap data).
NEXT_PUBLIC_MAP_STYLE_URL=
